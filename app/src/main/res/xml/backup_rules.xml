<?xml version="1.0" encoding="utf-8"?><!--
   Règles de sauvegarde pour Android 11 et antérieurs (ignorées à partir de
   l'API 31, où `data_extraction_rules.xml` prend le relais).

   Même intention que `android:allowBackup="false"` : rien ne sort de
   l'appareil. Le fichier est référencé par le manifeste pour que la règle
   soit lisible à un seul endroit, quel que soit l'âge du système.

   Voir https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
