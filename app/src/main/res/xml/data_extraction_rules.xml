<?xml version="1.0" encoding="utf-8"?><!--
   MedLingo est local-first et privé par défaut : aucune donnée ne quitte
   l'appareil via la sauvegarde cloud ou le transfert appareil → appareil.

   `android:allowBackup="false"` ne suffit pas à partir d'Android 12 : la
   sauvegarde cloud ET le transfert direct passent par ce fichier. Les
   exclusions ci-dessous rendent le comportement explicite et identique à
   celui de `allowBackup="false"` sur les versions antérieures.

   Voir https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
